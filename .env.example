# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe (for checkout / payments)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Resend (contact form, newsletter, inbound email — Vercel functions only;
# local dev stores contact submissions in Supabase instead)
RESEND_API_KEY=re_...
# Where contact form messages are delivered. Use the branded address (routed
# through Resend inbound → api/inbound.ts → forwarded) so Gmail replies default
# to the branded From. See docs/email-reply-privacy.md.
CONTACT_TO_EMAIL=Corinne@bladeandquillartacademy.com
# Verified Resend sender (use onboarding@resend.dev until the domain is verified)
CONTACT_FROM_EMAIL="Blade & Quill <contact@bladeandquillartacademy.com>"
# Resend Audience that stores newsletter subscribers
RESEND_AUDIENCE_ID=
# Optional HMAC secret for signed unsubscribe links (defaults to RESEND_API_KEY)
NEWSLETTER_UNSUBSCRIBE_SECRET=
# Inbound email (api/inbound.ts): signing secret of the Resend email.received
# webhook, and the private inbox that receives forwarded branded mail.
RESEND_WEBHOOK_SECRET=whsec_...
INBOUND_FORWARD_TO_EMAIL=

# Tina Cloud (checkout loads Shop Product prices from Tina; also used by the site)
TINA_PUBLIC_CLIENT_ID=
TINA_TOKEN=
# Browser-safe read-only token for runtime content refresh (set on Vercel too).
# Prefer a Tina Cloud *read-only* content token; may match TINA_TOKEN if that token is read-only.
TINA_PUBLIC_READONLY_TOKEN=
TINA_BRANCH=main

# Anthropic (AI-suggested SEO metadata in the CMS — /api/seo-suggest).
# Without a key the SEO fields still work; only the auto-suggestions are off.
ANTHROPIC_API_KEY=sk-ant-...
# Optional model override (default: claude-haiku-4-5)
SEO_SUGGEST_MODEL=

# Google Analytics 4 (same Measurement ID as Squarespace for continuous history)
# Client-side pageviews / conversion events (injected at Vite build time):
VITE_GA_MEASUREMENT_ID=G-50YS8RZ7HL
# Server-side Owner Insights (/api/insights) via GA4 Data API:
# Numeric Property ID from GA Admin → Property settings (not the G- measurement ID).
GA_PROPERTY_ID=
# Service account JSON (raw or base64). Grant the account Viewer on the GA4 property.
GA_SERVICE_ACCOUNT_JSON=

# Editing guide (/guide) — shared password for Corinne's how-to page.
# Required for the guide to unlock (set on Vercel: Production + Preview, and
# locally for the dev API server). Rotating it signs everyone out.
GUIDE_PASSWORD=
# Optional extra secret mixed into the guide session cookie (defaults internally)
GUIDE_COOKIE_SECRET=

# Server (Express API — use a port that does not conflict with Vite)
PORT=5000
BASE_PATH=/

# Vite dev: proxy /api to the Express server (must match PORT above when local)
# Set in artifacts/blade-quill env or shell when running the frontend.
VITE_API_PROXY_TARGET=http://127.0.0.1:5000
