# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe (for checkout / payments)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Tina Cloud (checkout loads Shop Product prices from Tina; also used by the site)
TINA_PUBLIC_CLIENT_ID=
TINA_TOKEN=
# Browser-safe read-only token for runtime content refresh (set on Vercel too).
# Prefer a Tina Cloud *read-only* content token; may match TINA_TOKEN if that token is read-only.
TINA_PUBLIC_READONLY_TOKEN=
TINA_BRANCH=main

# Google Analytics 4 (same Measurement ID as Squarespace for continuous history)
# Client-side pageviews / conversion events (injected at Vite build time):
VITE_GA_MEASUREMENT_ID=G-50YS8RZ7HL
# Server-side Owner Insights (/api/insights) via GA4 Data API:
# Numeric Property ID from GA Admin → Property settings (not the G- measurement ID).
GA_PROPERTY_ID=
# Service account JSON (raw or base64). Grant the account Viewer on the GA4 property.
GA_SERVICE_ACCOUNT_JSON=

# Server (Express API — use a port that does not conflict with Vite)
PORT=5000
BASE_PATH=/

# Vite dev: proxy /api to the Express server (must match PORT above when local)
# Set in artifacts/blade-quill env or shell when running the frontend.
VITE_API_PROXY_TARGET=http://127.0.0.1:5000
