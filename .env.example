# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe (for checkout / payments)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Server (Express API — use a port that does not conflict with Vite)
PORT=5000
BASE_PATH=/

# Vite dev: proxy /api to the Express server (must match PORT above when local)
# Set in artifacts/blade-quill env or shell when running the frontend.
VITE_API_PROXY_TARGET=http://127.0.0.1:5000
