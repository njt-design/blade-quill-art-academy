{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install",
  "buildCommand": "pnpm --filter @workspace/blade-quill run build:static",
  "outputDirectory": "artifacts/blade-quill/dist/public",
  "framework": null,
  "redirects": [
    {
      "source": "/((?!assets/|images/|admin|favicon\\.svg|opengraph\\.jpg).+)",
      "has": [{ "type": "host", "value": "newrelease.bladeandquillartacademy.com" }],
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/admin/:path*",
      "has": [
        { "type": "host", "value": "blade-quill-art-academy-.+\\.vercel\\.app" }
      ],
      "destination": "https://blade-quill-art-academy.vercel.app/admin/:path*",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "newrelease.bladeandquillartacademy.com" }],
      "destination": "/important-links-page"
    },
    { "source": "/((?!assets/).*)", "destination": "/index.html" }
  ]
}
